# Base URL of the Spring Boot backend (Railway, local, etc).
# Used ONLY by next.config.js's rewrite (server-side), never exposed to the browser.
# Do NOT prefix with NEXT_PUBLIC_ — the browser must never talk to this origin directly,
# because SameSite=Strict cookies require same-origin requests through the Next.js proxy.
BACKEND_BASE_URL=https://incident-room-brain.up.railway.app

# Public origin this frontend is served from (no trailing slash). Used server-side
# only, to build ABSOLUTE urls for metadataBase, Open Graph tags, sitemap.xml entries,
# and robots.txt's sitemap pointer — none of which can use relative paths. This is not
# sensitive (it's the same URL a visitor already sees in their address bar), but it
# doesn't need NEXT_PUBLIC_ either, since app/layout.tsx's metadata, app/sitemap.ts,
# and app/robots.ts all run on the server, never in the browser bundle.
SITE_URL=http://localhost:3000
